<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: baby's name, time since the last feed (a live
     clock), asleep/awake, and the next vaccine. Filled in by
     PalnaWidgetProvider from what the app saves. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/palna_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/baby_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Palna"
        android:textColor="#E3B778"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#DDE2EC"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/feed_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/feed_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDE2EC"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/feed_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/feed_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAB4C8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/sleep_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDE2EC"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/sleep_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/vaccine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F6C1C5"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
