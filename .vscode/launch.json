{
  // F5 / Run > Start Debugging. The app needs its server config from
  // app/env/*.json; plain `flutter run` without it stops on the logo.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Palna (cloud)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/prod.json"]
    }
  ]
}
