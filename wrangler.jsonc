// palnacare.com: Cloudflare builds this on every push to main
// (Workers & Pages > late-butterfly-bc9d > Settings > Build).
// Only the website folder is uploaded; nothing else in the repo is served.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "late-butterfly-bc9d",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./website",
    "not_found_handling": "404-page"
  }
}
